<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>VostokWarehouseMobile</RootNamespace>
    <ApplicationTitle>VOSTOK-WAREHOUSE</ApplicationTitle>
    <ApplicationId>com.vostok.warehouse</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
    <PackageReference Include="LibVLCSharp.MAUI" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Android" Version="3.7.0" />
  </ItemGroup>
</Project>
