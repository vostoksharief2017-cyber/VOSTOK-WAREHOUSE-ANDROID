<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net10.0-android</TargetFramework>

    <OutputType>Exe</OutputType>

    <RootNamespace>VostokWarehouseMobile</RootNamespace>

    <ApplicationTitle>VOSTOK-WAREHOUSE</ApplicationTitle>

    <ApplicationId>com.vostok.warehouse</ApplicationId>

    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <UseMaui>true</UseMaui>

    <SingleProject>true</SingleProject>

    <MauiVersion>10.0.60</MauiVersion>

  </PropertyGroup>


  <!-- ========================================================= -->
  <!-- MAUI + MEDIA ELEMENT -->
  <!-- ========================================================= -->

  <ItemGroup>

    <PackageReference
      Include="Microsoft.Maui.Controls"
      Version="$(MauiVersion)" />

    <PackageReference
      Include="CommunityToolkit.Maui.MediaElement"
      Version="10.0.0" />

  </ItemGroup>


  <!-- ========================================================= -->
  <!-- ANDROID PERMISSIONS -->
  <!-- ========================================================= -->

  <ItemGroup>

    <AndroidPermission
      Include="android.permission.INTERNET" />

    <AndroidPermission
      Include="android.permission.ACCESS_NETWORK_STATE" />

    <AndroidPermission
      Include="android.permission.ACCESS_WIFI_STATE" />

  </ItemGroup>

</Project>
