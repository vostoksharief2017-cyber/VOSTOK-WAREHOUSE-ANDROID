<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.Platforms.Maui;assembly=LibVLCSharp.Platforms.Maui"
             x:Class="VostokWarehouseMobile.MainPage"
             Title="VOSTOK-WAREHOUSE">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="VOSTOK-WAREHOUSE" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Text="Warehouse Camera" FontSize="17" FontAttributes="Bold"/>
            <Picker x:Name="CameraPicker" Title="Select Warehouse Camera" SelectedIndexChanged="CameraPicker_SelectedIndexChanged"/>
            <Border StrokeThickness="1" HeightRequest="220">
                <vlc:VideoView x:Name="VideoView"/>
            </Border>
            <Label x:Name="CameraStatus" Text="Select a camera" FontSize="13"/>
            <BoxView HeightRequest="1"/>
            <Label Text="Door Control" FontSize="17" FontAttributes="Bold"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Text="Door 1 - WH7" Grid.Row="0" Grid.Column="0" Clicked="Door1_Clicked"/>
                <Button Text="Door 2 - WH9" Grid.Row="0" Grid.Column="1" Clicked="Door2_Clicked"/>
                <Button Text="Door 3 - DISABLED" Grid.Row="1" Grid.Column="0" BackgroundColor="Gray" IsEnabled="False"/>
                <Button Text="Door 4 - WH4" Grid.Row="1" Grid.Column="1" Clicked="Door4_Clicked"/>
                <Button Text="Door 5 - WH5" Grid.Row="2" Grid.Column="0" Clicked="Door5_Clicked"/>
            </Grid>
            <Label Text="Hikvision Password" FontSize="17" FontAttributes="Bold"/>
            <Entry x:Name="PasswordEntry" Placeholder="Enter Hikvision password" IsPassword="True"/>
            <Button Text="Save Password" Clicked="SavePassword_Clicked"/>
            <Label x:Name="StatusLabel" Text="Ready" FontSize="13"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
