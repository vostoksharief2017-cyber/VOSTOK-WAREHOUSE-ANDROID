<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VostokWarehouseMobile.MainPage"
    Title="VOSTOK WAREHOUSE">

    <Grid
        RowDefinitions="Auto,*,Auto"
        Padding="10"
        RowSpacing="10">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="8">

            <Label
                Text="VOSTOK WAREHOUSE"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Picker
                x:Name="CameraPicker"
                Title="Select Camera"
                SelectedIndexChanged="CameraPicker_SelectedIndexChanged" />

            <Label
                x:Name="CameraStatus"
                Text="Select a camera"
                HorizontalOptions="Center"
                FontSize="14" />

            <Label
                x:Name="StatusLabel"
                Text="Ready"
                HorizontalOptions="Center"
                FontSize="12" />

        </VerticalStackLayout>


        <!-- ================================================= -->
        <!-- RTSP LIVE VIEW -->
        <!-- ================================================= -->

        <Border
            Grid.Row="1"
            StrokeThickness="1"
            Margin="0,5">

            <!-- Native Android PlayerView is inserted here -->
            <Grid
                x:Name="VideoContainer"
                BackgroundColor="Black"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">

                <Label
                    x:Name="VideoPlaceholder"
                    Text="Select a camera"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- DOOR BUTTONS -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*,*,*"
            ColumnSpacing="5">

            <Button
                Grid.Column="0"
                Text="Door 1"
                Clicked="Door1_Clicked" />

            <Button
                Grid.Column="1"
                Text="Door 2"
                Clicked="Door2_Clicked" />

            <Button
                Grid.Column="2"
                Text="Door 4"
                Clicked="Door4_Clicked" />

            <Button
                Grid.Column="3"
                Text="Door 5"
                Clicked="Door5_Clicked" />

        </Grid>

    </Grid>

</ContentPage>
