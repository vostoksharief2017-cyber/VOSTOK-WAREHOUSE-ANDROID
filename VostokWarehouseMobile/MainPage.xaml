<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VostokWarehouseMobile.MainPage">

    <Grid
        RowDefinitions="Auto,*,Auto"
        Padding="10">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="8">

            <Label
                Text="VOSTOK WAREHOUSE"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Picker
                x:Name="CameraPicker"
                Title="Select Camera"
                SelectedIndexChanged="CameraPicker_SelectedIndexChanged" />

            <Label
                x:Name="CameraStatus"
                Text="Select a camera"
                HorizontalOptions="Center" />

            <Label
                x:Name="StatusLabel"
                Text="Ready"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

        <Border
            Grid.Row="1"
            StrokeThickness="1"
            Margin="0,10">

            <Grid
                BackgroundColor="Black">

                <Label
                    Text="LIVE VIEW"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Grid>

        </Border>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*,*,*"
            ColumnSpacing="5">

            <Button
                Grid.Column="0"
                Text="Door 1"
                Clicked="Door1_Clicked" />

            <Button
                Grid.Column="1"
                Text="Door 2"
                Clicked="Door2_Clicked" />

            <Button
                Grid.Column="2"
                Text="Door 4"
                Clicked="Door4_Clicked" />

            <Button
                Grid.Column="3"
                Text="Door 5"
                Clicked="Door5_Clicked" />

        </Grid>

    </Grid>

</ContentPage>
