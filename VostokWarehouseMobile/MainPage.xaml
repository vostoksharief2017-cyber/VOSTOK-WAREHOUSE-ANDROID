<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shared="clr-namespace:LibVLCSharp.MAUI;assembly=LibVLCSharp.MAUI"
    x:Class="VostokWarehouseMobile.MainPage"
    Title="VOSTOK-WAREHOUSE">
<Grid x:Name="VideoContainer" />

    <Grid>

        <!-- Background -->
        <Image
            Source="background.jpg"
            Aspect="AspectFill"
            Opacity="0.15" />

        <!-- Main Application -->
        <ScrollView>

            <VerticalStackLayout
                Padding="16"
                Spacing="10">

                <!-- Header -->
                <Label
                    Text="VOSTOK-WAREHOUSE"
                    FontSize="26"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="White" />

                <!-- ============================= -->
                <!-- CAMERA -->
                <!-- ============================= -->

                <Label
                    Text="Warehouse Camera"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Picker
                    x:Name="CameraPicker"
                    Title="Select Warehouse Camera"
                    SelectedIndexChanged="CameraPicker_SelectedIndexChanged" />

                <!-- ============================= -->
                <!-- LIVE VIDEO -->
                <!-- ============================= -->

                <Border
                    HeightRequest="220"
                    StrokeThickness="1"
                    Stroke="Gray">

                    <Grid BackgroundColor="Black">

                        <shared:VideoView
                            x:Name="VideoView"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />

                        <Label
                            x:Name="VideoPlaceholder"
                            Text="Select a camera"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

                <Label
                    x:Name="CameraStatus"
                    Text="Select a camera"
                    FontSize="13"
                    TextColor="White" />

                <BoxView
                    HeightRequest="1"
                    BackgroundColor="Gray" />


                <!-- ============================= -->
                <!-- DOOR CONTROL -->
                <!-- ============================= -->

                <Label
                    Text="Door Control"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="8"
                    RowSpacing="8">

                    <Button
                        Text="Door 1 - WH7"
                        Grid.Row="0"
                        Grid.Column="0"
                        Clicked="Door1_Clicked" />

                    <Button
                        Text="Door 2 - WH9"
                        Grid.Row="0"
                        Grid.Column="1"
                        Clicked="Door2_Clicked" />

                    <Button
                        Text="Door 3 - DISABLED"
                        Grid.Row="1"
                        Grid.Column="0"
                        IsEnabled="False" />

                    <Button
                        Text="Door 4 - WH4"
                        Grid.Row="1"
                        Grid.Column="1"
                        Clicked="Door4_Clicked" />

                    <Button
                        Text="Door 5 - WH5"
                        Grid.Row="2"
                        Grid.Column="0"
                        Clicked="Door5_Clicked" />

                </Grid>


                <!-- ============================= -->
                <!-- STATUS -->
                <!-- ============================= -->

                <Label
                    Text="System Status"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    x:Name="StatusLabel"
                    Text="Ready"
                    FontSize="13"
                    TextColor="White" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
