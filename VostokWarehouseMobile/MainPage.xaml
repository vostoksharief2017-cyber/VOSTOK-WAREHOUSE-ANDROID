<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:shared="clr-namespace:LibVLCSharp.MAUI;assembly=LibVLCSharp.MAUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VostokWarehouseMobile.MainPage">

    <Grid
        RowDefinitions="Auto,*,Auto"
        Padding="10">

        <!-- HEADER -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="8">

            <Label
                Text="VOSTOK WAREHOUSE"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Picker
                x:Name="CameraPicker"
                Title="Select Camera"
                SelectedIndexChanged="CameraPicker_SelectedIndexChanged" />

            <Label
                x:Name="CameraStatus"
                Text="Select a camera"
                HorizontalOptions="Center" />

            <Label
                x:Name="StatusLabel"
                Text="Starting..."
                HorizontalOptions="Center" />

        </VerticalStackLayout>

        <!-- LIVE VIEW CONTAINER -->
<shared:VideoView
    x:Name="VideoView"
    HorizontalOptions="Fill"
    VerticalOptions="Fill" />

        <Border
            Grid.Row="1"
            StrokeThickness="1"
            Margin="0,10">

            <Grid
                x:Name="VideoContainer"
                BackgroundColor="Black" />

        </Border>

        <!-- DOOR BUTTONS -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*,*,*"
            ColumnSpacing="5">

            <Button
                Grid.Column="0"
                Text="Door 1"
                Clicked="Door1_Clicked" />

            <Button
                Grid.Column="1"
                Text="Door 2"
                Clicked="Door2_Clicked" />

            <Button
                Grid.Column="2"
                Text="Door 4"
                Clicked="Door4_Clicked" />

            <Button
                Grid.Column="3"
                Text="Door 5"
                Clicked="Door5_Clicked" />

        </Grid>

    </Grid>

</ContentPage>
